#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <numeric>

using namespace std;

class Character {
  private:
  string name;
  int health;
  int level;

  public:

  Character(string newName, int newHealth, int newLevel){
    name = newName;
    health = newHealth;
    level = newLevel;
  }
  bool deadChar(){
    if(health == 0){
      cout << name << " is dead and cannot do any further actions. \n";
      return true;
    }
      return false;
  }
  string getName(){
    return name;
  }
  int getHealth(){
    return health;
  }
  int getLevel(){
    return level;
  }
  void heal(int healAmt){
    if(!deadChar()){
      if(healAmt > 0){
        cout << name << " attempted to heal " << healAmt << "\n";
        if((health + healAmt) > 100){
          health = 100;
          return;
        }
        else{
          health = health + healAmt;
          return;
        }
      }
      else {
        cout << "Not a valid number to heal.";
        return;
      }
    }
  }
  void takeDamage(int damAmt){
    if(damAmt < 0){
      cout << "Invalid input, damage cannot be below 0. \n";
      return;
    }
    if(deadChar()){
      return;
    }
    cout << name << " took " << damAmt << " damage. \n";
    if(damAmt >= health){
      health = 0;
      cout << name << " has died. \n";
      return;
    }
    else{
      health = health - damAmt;
    }
  }
  void attackPower(){
    if(!deadChar()){
    int damage = level * 2;
  }
  }
  void levelUp(int newLevel){
    if(!deadChar()){
    level = level + newLevel;
    }
  }
  void displayInfo(){
    cout << "Name: " << name << " \n";
    cout << "Health: " << health << " \n";
    cout << "Level: " << level << " \n";
  }
};

